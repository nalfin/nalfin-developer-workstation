#!/usr/bin/env bash
# =============================================================================
# bootstrap/install — Install NDW on a new workstation
#
# Usage:
#   bash bootstrap/install
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NDW_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export NDW_ROOT

source "$NDW_ROOT/cli/lib/output.sh"
source "$NDW_ROOT/cli/lib/common.sh"

INSTALL_BIN="$HOME/.local/bin"
INSTALL_SYMLINK="$INSTALL_BIN/ndw"
NDW_CONFIG_DIR="$HOME/.config/ndw"

main() {
  output_header "NDW — Install"

  _create_dirs
  _install_symlink
  _check_path

  output_info "Installing dotfiles..."
  bash "$NDW_ROOT/bootstrap/dotfiles"

  _done
}

_create_dirs() {
  output_info "Creating directories..."
  mkdir -p "$INSTALL_BIN"
  mkdir -p "$NDW_CONFIG_DIR"
  output_success "Directories ready"
}

_install_symlink() {
  output_info "Installing ndw → $INSTALL_SYMLINK"

  [[ -L "$INSTALL_SYMLINK" ]] && rm "$INSTALL_SYMLINK"

  chmod +x "$NDW_ROOT/bin/ndw"

  if ln -s "$NDW_ROOT/bin/ndw" "$INSTALL_SYMLINK" 2>/dev/null; then
    output_success "Symlink created: $INSTALL_SYMLINK → $NDW_ROOT/bin/ndw"
  else
    cat > "$INSTALL_SYMLINK" << EOF
#!/usr/bin/env bash
exec bash "$NDW_ROOT/bin/ndw" "\$@"
EOF
    chmod +x "$INSTALL_SYMLINK"
    output_warning "Symlink failed — wrote a wrapper script instead: $INSTALL_SYMLINK"
    output_dim     "Enable Developer Mode on Windows for real symlinks (Settings → For developers)."
  fi
}

_check_path() {
  output_info "Checking PATH..."

  if echo "$PATH" | grep -q "$INSTALL_BIN"; then
    output_success "$INSTALL_BIN is already in PATH"
  else
    local rc="$HOME/.bashrc"
    is_macos && rc="$HOME/.zshrc"

    output_warning "$INSTALL_BIN is not in your PATH yet"
    output_blank
    echo "    Add this to your $rc:"
    echo ""
    echo '      export PATH="$HOME/.local/bin:$PATH"'
    echo ""
    echo "    Then reload:"
    echo ""
    echo "      source $rc"
    echo ""
  fi
}

_done() {
  output_blank
  output_success "NDW installed! Run: ndw --help"
  output_dim     "New device? Run 'ndw restore --ssh' first if you haven't."
  output_dim     "Want Node/PHP/Python/etc too? Run 'ndw setup' (optional, works from anywhere)."
  output_blank
}

main "$@"
