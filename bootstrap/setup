#!/usr/bin/env bash
# =============================================================================
# bootstrap/setup — Install optional dev tools (Windows/macOS)
#
# This is OPTIONAL. NDW's core job (bootstrap/install) only restores your
# SSH keys and dotfiles. Run this separately, whenever you want, to install
# language runtimes and CLI tools too.
#
# Usage:
#   bash bootstrap/setup
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NDW_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export NDW_ROOT

source "$NDW_ROOT/cli/lib/output.sh"
source "$NDW_ROOT/cli/lib/common.sh"

main() {
  output_header "NDW — Optional Tools Setup"

  if ! is_windows && ! is_macos; then
    output_error "This script supports Windows (Git Bash) and macOS only."
    output_info  "On Linux/WSL, install tools with your usual package manager."
    exit 1
  fi

  output_dim "Detected: $(os_label)"
  output_blank

  _menu
}

_menu() {
  echo "  What do you want to install?"
  echo ""
  local options=(
    "Node.js (+ pnpm)"
    "PHP + Composer"
    "Python + uv"
    "Starship (prompt) + lazygit + rclone"
    "Everything above"
    "Skip"
  )

  select opt in "${options[@]}"; do
    case "$REPLY" in
      1) _install_node; break ;;
      2) _install_php; break ;;
      3) _install_python; break ;;
      4) _install_extras; break ;;
      5) _install_node; _install_php; _install_python; _install_extras; break ;;
      6) output_info "Skipped."; break ;;
      *) echo "  Invalid choice, try again." ;;
    esac
  done

  output_blank
  output_success "Done. Run 'ndw doctor' to verify."
  output_blank
}

# ---------------------------------------------------------------------------
# Per-OS package install helper
# ---------------------------------------------------------------------------
_pkg() {
  # _pkg <label> <check-cmd> <winget-id> <brew-formula>
  local label="$1" check="$2" winget_id="$3" brew_formula="$4"

  if command_exists "$check"; then
    output_success "$label already installed"
    return
  fi

  output_info "Installing $label..."
  if is_windows; then
    require_command "winget" "Install 'App Installer' from the Microsoft Store first"
    winget install --silent --accept-package-agreements --accept-source-agreements -e --id "$winget_id"
  elif is_macos; then
    require_command "brew" "Install Homebrew first: https://brew.sh"
    brew install "$brew_formula"
  fi
  output_success "$label installed"
}

_install_node() {
  output_header "Node.js"
  _pkg "Node.js" "node" "OpenJS.NodeJS.LTS" "node"
  if ! command_exists "pnpm"; then
    output_info "Installing pnpm..."
    npm install -g pnpm
    output_success "pnpm installed"
  else
    output_success "pnpm already installed"
  fi
}

_install_php() {
  output_header "PHP + Composer"
  _pkg "PHP" "php" "PHP.PHP" "php"
  if ! command_exists "composer"; then
    output_info "Installing Composer..."
    php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');"
    php composer-setup.php --quiet
    rm -f composer-setup.php
    if is_windows; then
      mkdir -p "$HOME/.local/bin"
      mv composer.phar "$HOME/.local/bin/composer"
      output_dim "Add ~/.local/bin to PATH if 'composer' isn't found."
    else
      sudo mv composer.phar /usr/local/bin/composer
    fi
    output_success "Composer installed"
  else
    output_success "Composer already installed"
  fi
}

_install_python() {
  output_header "Python + uv"
  if command_exists "python3" || command_exists "python"; then
    output_success "Python already installed"
  else
    output_info "Installing Python..."
    if is_windows; then
      require_command "winget" "Install 'App Installer' from the Microsoft Store first"
      winget install --silent --accept-package-agreements --accept-source-agreements -e --id "Python.Python.3"
    elif is_macos; then
      require_command "brew" "Install Homebrew first: https://brew.sh"
      brew install python3
    fi
    output_success "Python installed"
  fi
  if ! command_exists "uv"; then
    output_info "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    output_success "uv installed"
  else
    output_success "uv already installed"
  fi
}

_install_extras() {
  output_header "Starship, lazygit, rclone"
  _pkg "Starship" "starship" "Starship.Starship" "starship"
  _pkg "lazygit"  "lazygit"  "JesseDuffield.lazygit" "lazygit"
  _pkg "rclone"   "rclone"   "Rclone.Rclone" "rclone"
}

main "$@"
